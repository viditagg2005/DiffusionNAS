      {
        "branch": 3,
        "interval": 2
      },
      {
        "branch": 3,
        "interval": 2
      },
      {
        "branch": 3,
        "interval": 2
      },
      {
        "branch": 3,
        "interval": 2
      },
      {
        "branch": 3,
